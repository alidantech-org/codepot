{
  "openapi": "3.1.0",
  "info": {
    "title": "Portable Contract API",
    "version": "v1",
    "description": "Executable template-variable probe fixture"
  },
  "servers": [
    {
      "url": "https://portable.example.test/v1",
      "description": "Fixture server",
      "variables": {
        "region": {
          "default": "test"
        }
      }
    }
  ],
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "tags": ["widgets"],
        "description": "List fixture widgets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetListResponse"
                }
              }
            }
          }
        },
        "x-operation-probe": {
          "enabled": true
        }
      },
      "post": {
        "operationId": "createWidget",
        "tags": ["widgets"],
        "description": "Create a fixture widget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWidgetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created widget",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        },
        "x-operation-probe": {
          "enabled": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WidgetStatus": {
        "type": "string",
        "enum": ["active", "disabled"],
        "x-schema-probe": "status"
      },
      "Widget": {
        "type": "object",
        "description": "Fixture widget",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/WidgetStatus"
          }
        },
        "x-schema-probe": "widget"
      },
      "WidgetListResponse": {
        "type": "object",
        "description": "Fixture list response",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Widget"
            }
          }
        },
        "x-schema-probe": "widget-list-response"
      },
      "CreateWidgetRequest": {
        "type": "object",
        "description": "Fixture create request",
        "required": ["status"],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/WidgetStatus"
          }
        },
        "x-schema-probe": "create-widget-request"
      }
    }
  },
  "x-portable-probe": {
    "enabled": true,
    "label": "lossless"
  }
}
