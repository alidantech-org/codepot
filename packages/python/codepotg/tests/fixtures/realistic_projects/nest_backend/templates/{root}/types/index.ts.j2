/**
 * ---------------------------------------------------------------------------
 * Type Barrel
 * ---------------------------------------------------------------------------
 *
 * Re-exports generated schemas grouped by resource path.
 */
{% for resource in resources if resource.schemas %}
export * from './{{ resource.emit.resource_path | join("/") }}';
{% endfor %}
{% for dto in schemas.emit_dtos %}
export * from './{{ dto.emit.resource_path | join("/") }}/dto/{{ dto.name.kebab.o }}';
{% endfor %}
{% for enum in schemas.emit_enums %}
export * from './{{ enum.emit.resource_path | join("/") }}/enums/{{ enum.name.kebab.o }}';
{% endfor %}
