{
  "name": "codepotx",
  "version": "0.0.0",
  "description": "TypeScript authoring and code-generation engine for Codepot.",
  "type": "module",
  "license": "MIT",
  "author": { "name": "AlidanTech", "url": "https://alidantech.org" },
  "homepage": "https://code.alidantech.org/",
  "repository": { "type": "git", "url": "git+https://github.com/alidantech-org/codepot.git", "directory": "packages/nodejs/codepotx" },
  "bugs": { "url": "https://github.com/alidantech-org/codepot/issues" },
  "engines": { "node": ">=22.18.0" },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./contract": { "types": "./dist/contract/index.d.mts", "import": "./dist/contract/index.mjs" },
    "./runtime": { "types": "./dist/runtime/index.d.mts", "import": "./dist/runtime/index.mjs" },
    "./platform": { "types": "./dist/platform/index.d.mts", "import": "./dist/platform/index.mjs" },
    "./authoring": { "types": "./dist/authoring/index.d.mts", "import": "./dist/authoring/index.mjs" },
    "./templating": { "types": "./dist/templating/index.d.mts", "import": "./dist/templating/index.mjs" },
    "./generation": { "types": "./dist/generation/index.d.mts", "import": "./dist/generation/index.mjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/all.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "package:lint": "publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm package:lint",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": { "handlebars": "4.7.9", "tsx": "4.23.1", "yaml": "2.9.0", "zod": "4.4.3" },
  "devDependencies": { "@arethetypeswrong/cli": "0.18.5", "@types/node": "22.20.1", "publint": "0.3.21", "tsdown": "0.22.12", "typescript": "7.0.2" },
  "keywords": ["codepot", "codegen", "typescript", "openapi", "contracts", "schema", "templates", "handlebars", "cli"]
}
