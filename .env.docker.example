# Public URL used for canonical links, sitemap entries, Open Graph metadata,
# and other Next.js build-time public metadata.
NEXT_PUBLIC_SITE_URL=https://code.alidantech.org

# The reverse proxy for code.alidantech.org forwards to http://localhost:3020.
# The container continues listening internally on port 3000.
SITE_PORT=3020
SITE_BIND_ADDRESS=127.0.0.1

# Optional image name or registry reference.
CODEPOT_SITE_IMAGE=codepot-site:latest
