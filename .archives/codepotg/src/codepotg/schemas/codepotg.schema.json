{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codepot.dev/codepotg/v1/codepotg.schema.json",
  "title": "CodepotG project configuration",
  "description": "Schema for Codepotg.yaml and Codepotg.yml generation task files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["allow", "tasks"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "JSON Schema URI used by editors and authoring tools."
    },
    "allow": {
      "type": "boolean",
      "description": "Explicit safety opt-in. Generation runs only when this is true."
    },
    "defaults": {
      "$ref": "#/$defs/taskDefaults"
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "commandObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "name": {"type": "string"},
        "run": {"type": "string", "minLength": 1},
        "cwd": {"$ref": "#/$defs/path"},
        "optional": {"type": "boolean", "default": false},
        "env": {"$ref": "#/$defs/environment"}
      }
    },
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/commandObject"}
      ]
    },
    "commandList": {
      "type": "array",
      "items": {"$ref": "#/$defs/command"}
    },
    "taskProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {"$ref": "#/$defs/path"},
        "language": {"type": "string", "minLength": 1},
        "output": {"$ref": "#/$defs/path"},
        "templateDir": {"$ref": "#/$defs/path"},
        "templates": {
          "$ref": "#/$defs/path",
          "deprecated": true,
          "description": "Compatibility alias for templateDir."
        },
        "frontend": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "clean": {
          "type": "array",
          "items": {"$ref": "#/$defs/path"}
        },
        "before": {"$ref": "#/$defs/commandList"},
        "after": {"$ref": "#/$defs/commandList"},
        "env": {"$ref": "#/$defs/environment"}
      }
    },
    "taskDefaults": {
      "$ref": "#/$defs/taskProperties"
    },
    "task": {
      "allOf": [
        {"$ref": "#/$defs/taskProperties"},
        {"required": ["input", "language", "output"]}
      ]
    }
  },
  "examples": [
    {
      "$schema": "https://schemas.codepot.dev/codepotg/v1/codepotg.schema.json",
      "allow": true,
      "tasks": {
        "client": {
          "input": "./openapi.json",
          "language": "typescript",
          "templateDir": "./templates",
          "output": "./src/generated"
        }
      }
    }
  ]
}
