{
  "name": "codepot-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Codepot authoring and code-generation workspace.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck test package:lint",
    "clean": "turbo run clean && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.turbo', { recursive: true, force: true });\""
  },
  "devDependencies": {
    "turbo": "2.10.5"
  }
}
