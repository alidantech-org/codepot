pub mod client;
pub mod models;
{% elif support.kind == "rust_models" -%}
{% for schema in schemas.emit_models %}pub mod {{ schema.name.snake.o }};
pub use {{ schema.name.snake.o }}::{{ schema.name.pascal.o }};
{% endfor %}{% for schema in schemas.emit_enums %}pub mod {{ schema.name.snake.o }};
pub use {{ schema.name.snake.o }}::{{ schema.name.pascal.o }};
{% endfor %}
{% elif support.kind == "rust_client" -%}
{% for operation in operations %}#[path = "{{ operation.name.pascal.o }}Client.rs"]
pub mod {{ operation.name.snake.o }}_client;
