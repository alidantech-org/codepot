{% for schema in schemas.emit_models %}from .{{ schema.name.snake.o }} import {{ schema.name.pascal.o }}
{% endfor %}{% for schema in schemas.emit_enums %}from .{{ schema.name.snake.o }} import {{ schema.name.pascal.o }}
{% endfor %}
__all__ = [
{% for schema in schemas.emit_models %}    "{{ schema.name.pascal.o }}",
{% endfor %}{% for schema in schemas.emit_enums %}    "{{ schema.name.pascal.o }}",
{% endfor %}]
{% elif support.kind == "python_client" -%}
{% for operation in operations %}from .{{ operation.name.pascal.o }}Client import {{ operation.lang.function_name }}
{% endfor %}
__all__ = [
{% for operation in operations %}    "{{ operation.lang.function_name }}",
{% endfor %}]
