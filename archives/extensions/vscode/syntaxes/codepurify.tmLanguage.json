{
  "name": "codepot",
  "scopeName": "source.codepot",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.codepot",
          "begin": "\\{\\|\\*",
          "end": "\\*\\|\\}"
        },
        {
          "name": "comment.block.codepot",
          "begin": "\\{\\|#",
          "end": "#\\|\\}"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "meta.block.codepot",
          "begin": "\\{\\|\\s*(if|loop|raw|unless|with)\\b",
          "beginCaptures": {
            "0": {
              "name": "meta.tag.template.begin.codepot"
            },
            "1": {
              "name": "keyword.control.codepot"
            }
          },
          "end": "\\|\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template.end.codepot"
            }
          },
          "patterns": [
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#aliases"
            },
            {
              "include": "#properties"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "meta.expression.codepot",
          "begin": "\\|",
          "end": "\\|\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template.begin.codepot"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template.end.codepot"
            }
          },
          "patterns": [
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#aliases"
            },
            {
              "include": "#properties"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.codepot",
          "match": "\\b(if|else|unless|with|raw)\\b"
        },
        {
          "name": "keyword.control.repeat.codepot",
          "match": "\\b(loop|for)\\b"
        },
        {
          "name": "keyword.control.end.codepot",
          "match": "\\/(if|loop|for|raw|unless|with)\\b"
        },
        {
          "name": "keyword.operator.word.codepot",
          "match": "\\b(as|in|not|and|or|is)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.codepot",
          "match": "(==|!=|<=|>=|<|>|!)"
        },
        {
          "name": "keyword.operator.logical.codepot",
          "match": "(&&|\\|\\|)"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.codepot",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "constant.numeric.codepot",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "string.quoted.single.codepot",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.codepot",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "aliases": {
      "patterns": [
        {
          "name": "variable.parameter.alias.codepot",
          "match": "(?<=\\bas\\s+)[a-zA-Z_$][a-zA-Z0-9_$]*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.path.entity.codepot",
          "match": "\\bentity\\.[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b"
        },
        {
          "name": "variable.other.path.field.codepot",
          "match": "\\bfield\\.[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b"
        },
        {
          "name": "variable.other.path.relation.codepot",
          "match": "\\brelation\\.[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b"
        },
        {
          "name": "variable.other.path.global.codepot",
          "match": "\\bglobal\\.[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b"
        },
        {
          "name": "variable.other.path.codepot",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)+\\b"
        },
        {
          "name": "variable.language.root.entity.codepot",
          "match": "\\bentity\\b"
        },
        {
          "name": "variable.language.root.field.codepot",
          "match": "\\bfield\\b"
        },
        {
          "name": "variable.language.root.relation.codepot",
          "match": "\\brelation\\b"
        },
        {
          "name": "variable.language.root.global.codepot",
          "match": "\\bglobal\\b"
        },
        {
          "name": "variable.language.root.resource.codepot",
          "match": "\\bresource\\b"
        },
        {
          "name": "variable.language.root.template.codepot",
          "match": "\\btemplate\\b"
        },
        {
          "name": "variable.language.root.item.codepot",
          "match": "\\b(item|index)\\b"
        },
        {
          "name": "variable.other.identifier.codepot",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "support.type.namespace.name.codepot",
          "match": "\\bname\\b"
        },
        {
          "name": "support.type.namespace.casing.codepot",
          "match": "\\bcasing\\b"
        },
        {
          "name": "support.type.namespace.validation.codepot",
          "match": "\\bvalidation\\b"
        },
        {
          "name": "support.type.namespace.array.codepot",
          "match": "\\barray\\b"
        },
        {
          "name": "support.type.namespace.flags.codepot",
          "match": "\\bflags\\b"
        },
        {
          "name": "support.type.namespace.counts.codepot",
          "match": "\\bcounts\\b"
        },
        {
          "name": "support.type.namespace.maps.codepot",
          "match": "\\bmaps\\b"
        },
        {
          "name": "support.type.namespace.items.codepot",
          "match": "\\bitems\\b"
        },
        {
          "name": "support.property.length.codepot",
          "match": "\\blength\\b"
        },
        {
          "name": "support.property.original.codepot",
          "match": "\\boriginal\\b"
        },
        {
          "name": "support.constant.casing.camel.codepot",
          "match": "\\bcamel\\b"
        },
        {
          "name": "support.constant.casing.pascal.codepot",
          "match": "\\bpascal\\b"
        },
        {
          "name": "support.constant.casing.snake.codepot",
          "match": "\\bsnake\\b"
        },
        {
          "name": "support.constant.casing.kebab.codepot",
          "match": "\\bkebab\\b"
        },
        {
          "name": "support.constant.casing.constant.codepot",
          "match": "\\bconstant\\b"
        },
        {
          "name": "support.constant.casing.dot.codepot",
          "match": "\\bdot\\b"
        },
        {
          "name": "support.constant.casing.slash.codepot",
          "match": "\\bslash\\b"
        },
        {
          "name": "support.constant.casing.path.codepot",
          "match": "\\bpath\\b"
        },
        {
          "name": "support.constant.casing.lower.codepot",
          "match": "\\blower\\b"
        },
        {
          "name": "support.constant.casing.upper.codepot",
          "match": "\\bupper\\b"
        },
        {
          "name": "support.constant.casing.title.codepot",
          "match": "\\btitle\\b"
        },
        {
          "name": "support.constant.casing.train.codepot",
          "match": "\\btrain\\b"
        },
        {
          "name": "support.property.rules.codepot",
          "match": "\\brules\\b"
        },
        {
          "name": "support.property.type.codepot",
          "match": "\\btype\\b"
        },
        {
          "name": "support.property.required.codepot",
          "match": "\\brequired\\b"
        }
      ]
    },
    "template-content": {
      "patterns": [
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#aliases"
        },
        {
          "include": "#properties"
        },
        {
          "include": "#variables"
        }
      ]
    }
  }
}
