    "grammars": [
      {
        "language": "codepot",
        "scopeName": "source.codepot",
        "path": "./syntaxes/codepot.tmLanguage.json"
      },
      {
        "language": "codepot-javascript",
        "scopeName": "source.js.codepot",
        "path": "./syntaxes/wrappers/codepot-javascript.tmLanguage.json"
      },
      {
        "language": "codepot-jsx",
        "scopeName": "source.jsx.codepot",
        "path": "./syntaxes/wrappers/codepot-jsx.tmLanguage.json"
      },
      {
        "language": "codepot-typescript",
        "scopeName": "source.ts.codepot",
        "path": "./syntaxes/wrappers/codepot-typescript.tmLanguage.json"
      },
