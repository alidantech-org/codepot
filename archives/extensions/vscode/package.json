    "snippets": [
      {
        "language": "codepot",
        "path": "./snippets/codepot.json"
      }
    ],
    "configuration": {
      "title": "codepot",
      "type": "object",
      "properties": {
        "codepot.theme.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable codepot theme customizations."
        },
        "codepot.theme.entityColor": {
          "type": "string",
          "default": "#50fa7b",
          "description": "Color for entity variables."
        },
        "codepot.theme.fieldColor": {
          "type": "string",
          "default": "#8be9fd",
          "description": "Color for field variables."
        },
        "codepot.theme.relationColor": {
          "type": "string",
          "default": "#bd93f9",
          "description": "Color for relation variables."
        },
        "codepot.theme.globalColor": {
          "type": "string",
          "default": "#ffb86c",
          "description": "Color for global variables."
        },
        "codepot.theme.templateColor": {
          "type": "string",
          "default": "#ff5555",
          "description": "Color for template variables."
        },
        "codepot.theme.delimiterColor": {
          "type": "string",
          "default": "#ff79c6",
          "description": "Color for `{| |}` template delimiters."
        },
        "codepot.theme.casingColor": {
          "type": "string",
          "default": "#a6e22e",
          "description": "Color for casing constants."
        },
        "codepot.theme.backgroundColor": {
          "type": "string",
          "default": "rgba(255, 121, 198, 0.1)",
          "description": "Background color for `{| ... |}` expressions."
        },
        "codepot.theme.borderColor": {
          "type": "string",
          "default": "rgba(255, 121, 198, 0.3)",
          "description": "Border color for `{| ... |}` expressions."
        },
        "codepot.theme.errorColor": {
          "type": "string",
          "default": "rgba(255, 85, 85, 0.2)",
          "description": "Background color for validation errors."
        },
        "codepot.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time validation."
        },
        "codepot.validation.strict": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict validation mode."
        },
        "codepot.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable intelligent autocomplete."
        },
        "codepot.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover documentation."
        },
        "codepot.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable visual decorations and backgrounds."
        },
        "codepot.decorations.opacity": {
          "type": "number",
          "default": 0.15,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity level for decorations."
        }
      }
    }
  },
  "scripts": {
    "generate": "node scripts/generate-package.mjs",
    "vscode:prepublish": "npm run generate && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {}
}
