{
  "name": "codepot-templates",
  "displayName": "codepot Templates",
  "version": "0.0.2",
  "description": "Template language support for deterministic codepot code generation with syntax highlighting, autocomplete, hover documentation, and validation.",
  "publisher": "alidantechorg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "codepot",
    "code generation",
    "templates",
    "syntax highlighting",
    "autocomplete"
  ],
  "author": {
    "name": "alidantech.org",
    "email": "peter@alidantech.org"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alidantech-org/codepot.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
