{
  "name": "@codepot/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "predev": "pnpm sync:docs",
    "dev": "next dev",
    "prebuild": "pnpm sync:docs",
    "build": "next build",
    "pretypecheck": "pnpm sync:docs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.next', { recursive: true, force: true }); rmSync('src/generated', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "0.468.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "shiki": "3.13.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.1.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
