{
  "name": "@codepot/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:docs": "node scripts/validate-docs.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "prepare:docs": "pnpm validate:docs && pnpm sync:docs",
    "predev": "pnpm prepare:docs",
    "dev": "next dev",
    "prebuild": "pnpm prepare:docs",
    "build": "next build",
    "pretypecheck": "pnpm prepare:docs",
    "typecheck": "tsc6 --noEmit",
    "prelint": "pnpm prepare:docs",
    "lint": "eslint .",
    "test": "pnpm validate:docs",
    "start": "next start",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.next', { recursive: true, force: true }); rmSync('src/generated', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/theme-one-dark": "6.1.3",
    "@next/third-parties": "16.2.4",
    "@uiw/react-codemirror": "4.25.11",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.14.0",
    "next": "16.2.4",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-syntax-highlighter": "16.1.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.6.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.1.18",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
