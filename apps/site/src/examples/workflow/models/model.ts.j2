{% set interface_name = model.name | pascal %}
/**
 * Generated from {{ model.source.name }}.
 * Do not edit this file directly.
 */
export interface {{ interface_name }} {
{% for field in model.fields %}
  /** {{ field.description or field.name }} */
  {{ field.name | camel }}{% if not field.required %}?{% endif %}: {{ field.lang.type }};
{% endfor %}
}

export const {{ interface_name }}Fields = [
{% for field in model.fields %}
  "{{ field.name }}",
{% endfor %}
] as const;

export type {{ interface_name }}Field =
  (typeof {{ interface_name }}Fields)[number];
